# 复制这个文件为 .env，然后填上你自己的值。
#
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会提交到 GitHub。
# 复制完记得收紧权限（服务器上尤其要）：
#
#   chmod 600 .env
#
# 里面是数据库密码，权限放开等于给机器上所有用户看。

# ── 数据库 ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在这里填你装 MySQL 时设的 root 密码
# 库名要和 schema/schema.sql 里写的一致。
# 不一致不会报错，只会建出一个别的库然后连不上——scripts/init_db.py 会提醒你。
DB_NAME=scitech_kb

# ── 服务端口 ──────────────────────────────────────────────
API_PORT=8000

# ── 网页写接口的口令 ──────────────────────────────────────
# 页面给部员用，服务要绑到校园网；绑出去之后写接口（录经验、登记分工、
# 新增成员）就再没有门槛了。这个口令就是那道门：部员在页面上输一次，
# 之后靠 cookie 记住。
#
# 留空 = 鉴权关闭。本地开发、跑测试时留空是对的；
# 服务器上的 .env **必须**填上，否则等于把库敞开。
# 启动日志里会明说当前是启用还是关闭。
#
# 它只挡「校园网里乱逛进来的人」，不区分是谁写的。要真身份得接学校 CAS。
KB_SHARED_PASSWORD=

# 允许跨域的来源，逗号分隔。**默认留空是对的**——
# 页面和接口同源，本来就不需要跨域。只有本地换端口调试才用得上。
#
# 服务器上要填的话写自己的地址，例如：
#   KB_CORS_ORIGINS=http://<服务器内网IP>:8000
# 注意：填了之后 allow_credentials 会跟着打开，所以**不能用 `*`**。
KB_CORS_ORIGINS=

# ── 数据管道线（数据拉取用）──────────────────────────────
# 只有做数据管道的人需要填。不填不影响其他线——
# pipeline/fetch.py 可以加 --from-file 直接读本地文件。
#
# 这几项都是敏感信息，只放这里，不要写进代码、文档、聊天记录。
# 值找服务器管理员要（见交接文档）。
SEATABLE_BASE_URL=
SEATABLE_TOKEN=
SEATABLE_DTABLE_UUID=
SEATABLE_MEMBER_TABLE=
SEATABLE_LEDGER_TABLE=
