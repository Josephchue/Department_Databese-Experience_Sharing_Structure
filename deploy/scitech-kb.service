# 知识库 API 的 systemd 服务单元。
#
# 安装位置：/etc/systemd/system/scitech-kb.service
#
# 注意：这个文件**不能**由共享账号直接放进去——
# 共享账号没有 sudo，/etc/systemd/system/ 对它只读。
# 装这个单元要找服务器管理员。详细步骤见同目录的 部署说明.md。
#
# 文件里的账号名和路径都是占位写法（<共享账号>）。
# 真实账号名见交接文档——本仓库是公开的，基础设施信息不写进来。
# 代码放在别的地方就要同步改下面六处：
#   User / Group / WorkingDirectory / ExecStart / ReadWritePaths / Environment=HF_HOME
#
# 改完必须跑 systemctl daemon-reload，否则 systemd 还用旧配置，
# 而且不会报任何错——典型的"改了没生效"。

[Unit]
Description=学创部知识库 API（FastAPI + Chroma 向量检索）
Documentation=https://github.com/KJ-scitech/Department_Databese-Experience_Sharing_Structure
After=network-online.target mariadb.service
Wants=network-online.target
# ★ 2026-09-22 在 M710q 上实测：这台机器上的数据库是 **MariaDB 10.11**，
#   单元名是 `mariadb.service`，**没有** `mysql.service`。
#   原来这里写的是 mysql.service —— 对不上号，等于没有"等数据库就绪"这层保护，
#   服务可能抢在数据库前面起来，然后在启动那一屏报连不上库。
#   （`After=` 写一个不存在的单元名**不会让服务起不来**，只是静默失效，
#     所以这个错从日志里看不出来。改单元名前先查：
#     systemctl list-units --type=service --all | grep -iE "maria|mysql"）
#   换一台机器部署的话，这行要跟着那台机器的实际单元名改。

[Service]
Type=simple
User=<共享账号>
Group=<共享账号>
WorkingDirectory=/home/<共享账号>/knowledge-base

ExecStart=/home/<共享账号>/knowledge-base/.venv/bin/python -m uvicorn api.main:app \
    --host 0.0.0.0 --port 8000

# ★ 绑 0.0.0.0 是为了让部员在校内网打开 http://<服务器内网IP>:8000 ——
#   页面要给人用，就得对外。**这里从 127.0.0.1 改过来，是上线的开关。**
#
#   改之前必须确认两件事，否则等于把库敞开：
#     1. .env 里配了 KB_SHARED_PASSWORD（否则写接口不设防）。
#        启动日志第一屏会明说当前是"已启用"还是"未启用"。
#     2. 读接口对外是**有意**的：/api/experiences、/api/cards、/api/reports
#        不登录也能看。介绍卡走的是 v_member_public 视图，只含能对外说的字段；
#        但经验正文会变成"校内可见"，记的时候心里要有数。
#
#   防护是 api/auth.py 那个中间件，不是这个文件：所有写方法（POST/PUT/PATCH/
#   DELETE）都要口令，本机 127.0.0.1 免口令（机器人走这条）。
#
#   还有两件没做的，写在这里免得忘：
#     · 没上 HTTPS。口令和 cookie 在校内网里是明文，被嗅探就能拿到。
#     · 写接口是**一个共享口令**，不区分是谁写的。要真身份得上学校 CAS。

# 日志直接进 journald，用 journalctl 看：
#   journalctl -u scitech-kb -f
Environment=PYTHONUNBUFFERED=1

# 向量模型缓存。不固定这个路径的话会落到 ~/.cache/huggingface，
# 而下面 ProtectHome 把家目录设成了只读，模型下不下来、服务起不来。
Environment=HF_HOME=/home/<共享账号>/knowledge-base/.cache/huggingface

Restart=always
RestartSec=5

# 首次启动要加载向量模型，约 20–30 秒。这段时间服务是"在起"的状态，
# 端口还没监听。别刚 systemctl start 完就 curl，会以为它挂了。
TimeoutStartSec=120
TimeoutStopSec=20

# ── 加固 ────────────────────────────────────────────────────
# 下面几行把服务能碰的范围限制在项目目录内。
# 如果服务起不来、报的错又看不懂（比如"无法写入"某个意想不到的路径），
# **先把这几行注释掉再试**——先确认业务能跑通，再回头收紧。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/<共享账号>/knowledge-base/data /home/<共享账号>/knowledge-base/.cache

[Install]
WantedBy=multi-user.target
